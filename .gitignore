# --- Rust ---
/target/
**/*.rs.bk
Cargo.lock          # workspace has binaries, but pinning is handled by the artifact image

# --- Python ---
# Compiled extensions must never be committed. A stale `python/mnemos_native.pyd` sat in the
# source tree for days and *shadowed* the freshly built one, because the documented workflow is
# `cd python && python -m eval...` and cwd precedes site-packages on sys.path. Every experiment
# run that way used a binary from a previous build with no indication that it had. See the
# provenance stamp in `python/eval/repro.py`, which now records where the extension loaded from.
*.pyd
*.so
*.dylib
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
build/
dist/

# --- Node ---
node_modules/

# ============================================================================
# SECURITY — never commit any of these
# ============================================================================

# Key material. The software keystore writes this; it is a plaintext root key.
*.key
mnemos-insecure.key

# Live stores. These contain real encrypted memories AND, more to the point, the
# on-disk artifacts an adversary would attack. Committing one publishes a snapshot.
*.slab
*.enc
memory.slab
index.slab
manifest.enc
wal.enc

# Harvested agent corpora (D1). These are the agent's real self-authored memories.
data/d1-hermes/
data/*.jsonl

# Anything that has touched plaintext
*.plaintext
*.decrypted

# ============================================================================
# Generated
# ============================================================================

# Experiment outputs are regenerated by `just repro`. Committed selectively and
# deliberately when a figure is finalised, never in bulk.
# Results are committed: the paper's numbers, tables and figures are generated from them.
python/eval/results/*.csv
python/eval/results/**/*.log

paper/figures/*.pdf
paper/figures/*.png
paper/generated/
!paper/figures/.gitkeep

# Criterion output
target/criterion/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Datasets ---
# Public corpora are fetched or generated by data/fetch_d2.py, data/generate_data.py and
# data/e3/build_corpora.py. Committed: the agent-written memories, which a local model wrote
# and which cannot be regenerated exactly, the issue corpus, and the scripts and manifests.
data/d2-beir/
data/d3-swebench/
data/e3/*
!data/e3/*.py
!data/e3/*.manifest.json
!data/e3/agent_memories.jsonl
!data/e3/github.jsonl
data/**/*.npy
data/**/*.parquet
# Local tool state
.claude/
# LaTeX intermediates
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.toc
paper/*.synctex.gz
python/eval/cache/
*.npy
# the pgvector experiment's embeddings and labels
!python/eval/e8/data/*.npy
python/eval/results/**/*.npz
.venv-fw/
tools/bin/
uv.lock

# Overnight pipeline logs (the report summarizes them)
python/eval/logs/
